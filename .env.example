# ──────────────────────────────────────────────
# VOXA — Environment Configuration Template
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit your actual .env file to Git!
# ──────────────────────────────────────────────

# ── Server & Environment ───────────────────────
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://voxa-cvsr.onrender.com
BACKEND_URL=https://voxa-cvsr.onrender.com
VOXA_BACKEND_URL=https://voxa-cvsr.onrender.com

# ── Rime TTS (Primary Voice Output) ────────────
# Get your API key at https://app.rime.ai/tokens
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL=coda
RIME_SPEAKER=astra
RIME_LANGUAGE=en
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts

# ── LLM (Intelligence Layer) ───────────────────
# Supported providers: gemini | openai | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
LLM_API_KEY=your_llm_api_key_here

# Mode: "live" for production, or "mock" for offline deterministic testing
LLM_MODE=live

# ── Google OAuth 2.0 (Calendar, Classroom, Gmail)
# Create OAuth 2.0 Web Client credentials at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: https://voxa-cvsr.onrender.com
# Authorized Redirect URI: https://voxa-cvsr.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://voxa-cvsr.onrender.com/api/auth/google/callback

# ── Session & Security ─────────────────────────
SESSION_SECRET=generate_a_secure_random_string_for_session
EXTENSION_SECRET=generate_a_secure_random_token_for_extension

# ── Chrome Extension (Optional) ────────────────
CHROME_EXTENSION_ID=your_chrome_extension_id_if_fixed
